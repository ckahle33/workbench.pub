{
  "name": "workbench.pub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate:remote": "wrangler d1 migrations apply workbench --remote",
    "deploy:web": "npm run build && wrangler deploy",
    "deploy:ingest": "wrangler deploy --config ingest/wrangler.toml",
    "seed:topics": "tsx --env-file-if-exists=.env scripts/seed-topics.ts"
  },
  "dependencies": {
    "@atproto/api": "^0.30.3",
    "@atproto/oauth-client-browser": "^0.5.14",
    "@atproto/oauth-types": "^0.7.7",
    "@atproto/syntax": "^0.7.7",
    "hono": "^4.13.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261108.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^4.1.0",
    "wrangler": "^4.158.0"
  }
}
