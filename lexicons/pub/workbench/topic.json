{
  "lexicon": 1,
  "id": "pub.workbench.topic",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "name",
          "slug",
          "description",
          "createdAt"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxGraphemes": 120,
            "maxLength": 1200
          },
          "slug": {
            "type": "string",
            "minLength": 2,
            "maxLength": 40,
            "description": "Lowercase [a-z0-9-]. Earliest record per slug is canonical."
          },
          "description": {
            "type": "string",
            "maxLength": 5000,
            "maxGraphemes": 500
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
