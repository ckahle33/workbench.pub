{
  "lexicon": 1,
  "id": "pub.workbench.follow",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "kind",
          "subject",
          "createdAt"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "knownValues": ["project", "topic"],
            "description": "What is being followed."
          },
          "subject": {
            "type": "string",
            "description": "For kind project, the at-uri of a pub.workbench.project record. For kind topic, the canonical topic slug."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
