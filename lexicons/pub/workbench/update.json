{
  "lexicon": 1,
  "id": "pub.workbench.update",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "project",
          "heading",
          "body",
          "createdAt"
        ],
        "properties": {
          "project": {
            "type": "string",
            "format": "at-uri"
          },
          "heading": {
            "type": "string",
            "maxGraphemes": 120,
            "maxLength": 1200
          },
          "body": {
            "type": "string",
            "maxGraphemes": 5000,
            "maxLength": 50000
          },
          "images": {
            "type": "array",
            "maxLength": 6,
            "items": {
              "type": "ref",
              "ref": "pub.workbench.defs#image"
            }
          },
          "links": {
            "type": "array",
            "maxLength": 8,
            "items": {
              "type": "ref",
              "ref": "pub.workbench.defs#link"
            }
          },
          "parts": {
            "type": "array",
            "maxLength": 40,
            "items": {
              "type": "ref",
              "ref": "pub.workbench.defs#part"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
