{
  "lexicon": 1,
  "id": "pub.workbench.project",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "title",
          "summary",
          "topic",
          "status",
          "createdAt"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxGraphemes": 120,
            "maxLength": 1200
          },
          "summary": {
            "type": "string",
            "maxGraphemes": 500,
            "maxLength": 5000
          },
          "topic": {
            "type": "string",
            "minLength": 2,
            "maxLength": 40,
            "description": "Topic slug."
          },
          "status": {
            "type": "string",
            "knownValues": [
              "in-progress",
              "finished",
              "paused"
            ]
          },
          "cover": {
            "type": "blob",
            "accept": [
              "image/*"
            ],
            "maxSize": 1000000
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
